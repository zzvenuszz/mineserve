# Copy this file to .env and replace the password before starting.
MINESERVE_PASSWORD=replace-with-a-long-random-password
MINESERVE_USER=admin

# Maximum Java heap allowed by the panel. Keep room for the OS and web panel.
MAX_RAM_MB=8192

# Minecraft Java Edition port. The panel uses port 8080.
MC_PORT=25565

# Use 127.0.0.1 to expose the panel only on the Docker host.
# Use 0.0.0.0 to make it available on your LAN.
WEB_BIND=0.0.0.0
